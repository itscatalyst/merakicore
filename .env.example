MERAKI_JWT_SECRET=replace-with-at-least-32-utf8-bytes
MERAKI_JWT_ISSUER=https://auth.meraki.local
MERAKI_JWT_AUDIENCE=meraki-core
MERAKI_TENANT_ID=local
MERAKI_SUBJECT_ID=builder
MERAKI_ACTOR_ID=builder
MERAKI_SESSION_ID=local-session
MERAKI_MCP_TOKEN=paste-the-output-of-pnpm-dev-token
MERAKI_RUNTIME_PATH=.meraki/runtime.json
PORT=3001

# Hosted application (use distinct secrets; never commit real values)
DATABASE_URL=postgresql://meraki_runtime:replace@host:5432/postgres?sslmode=require
MERAKI_TOKEN_PEPPER=replace-with-at-least-32-random-utf8-bytes
MERAKI_ALLOWED_ORIGINS=https://core.example.com
MERAKI_PUBLIC_BASE_URL=https://core.example.com
MERAKI_MAX_REQUEST_BYTES=1048576
