{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meraki.local/schemas/proof-manifest.schema.json",
  "title": "Meraki gate proof manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "native_goal_thread_id",
    "gate_id",
    "gate_status",
    "packets",
    "commands",
    "artifacts",
    "goal_evidence",
    "review"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "goal_id": { "const": "meraki-core-studio-foundation" },
    "native_goal_thread_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "gate_id": { "type": "string", "pattern": "^(G[0-8]|S[0-5])$" },
    "gate_status": { "enum": ["collecting", "ready_for_review", "accepted", "revised", "blocked", "NOT_STARTED", "IN_PROGRESS", "REVISE", "IMPLEMENTATION_COMPLETE_EXTERNAL_PROOF_DEFERRED", "ACCEPT", "BLOCKED_INTERNAL"] },
    "generated_at": { "type": ["string", "null"], "format": "date-time" },
    "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "packets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "active", "accepted", "revised", "blocked"] },
          "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "passed"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "passed": { "type": "boolean" },
          "output_artifact": { "type": ["string", "null"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "goal_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "status", "evidence"],
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "status": { "enum": ["not_started", "partial", "proven", "contradicted"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "regressions_added": { "type": "array", "items": { "type": "string" } },
    "known_limitations": { "type": "array", "items": { "type": "string" } },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "verdict", "verdict_artifact"],
      "properties": {
        "independent": { "type": "boolean" },
        "reviewer_context_id": { "type": ["string", "null"] },
        "verdict": { "enum": ["PENDING", "ACCEPT", "REVISE", "BLOCK", "IMPLEMENTATION_COMPLETE_EXTERNAL_PROOF_DEFERRED"] },
        "verdict_artifact": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "IMPLEMENTATION_COMPLETE_EXTERNAL_PROOF_DEFERRED" } } },
          "then": { "properties": { "independent": { "const": false } } },
          "else": { "properties": { "independent": { "const": true } } }
        }
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "description"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
