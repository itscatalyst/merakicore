{
  "name": "@meraki/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Meraki Core and Studio monorepo",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "corepack pnpm --filter @meraki/db build && node packages/db/dist/migrate.js up",
    "db:rollback": "corepack pnpm --filter @meraki/db build && node packages/db/dist/migrate.js down",
    "db:test-migrations": "vitest run packages/db/src/migrations.test.ts",
    "db:test-live": "node scripts/db/run-live-tests.mjs",
    "security:test-isolation": "vitest run packages/db/src/migrations.test.ts packages/security/src/index.test.ts",
    "contracts:generate": "python scripts/contracts/generate.py",
    "contracts:check": "python scripts/contracts/check.py",
    "orchestration:validate": "python scripts/orchestration/validate_execution_graph.py",
    "proof:validate": "python scripts/ci/validate_proof_manifest.py",
    "proof:verify": "python scripts/ci/capture_command_evidence.py verify --manifest ops/proof/G0-manifest.yaml",
    "runtime:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap/install-wsl-postgres.ps1",
    "ci:static": "corepack pnpm orchestration:validate && corepack pnpm proof:validate && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test",
    "ci:gate0": "corepack pnpm ci:static && corepack pnpm contracts:check && corepack pnpm db:test-migrations && corepack pnpm security:test-isolation && corepack pnpm db:test-live"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
